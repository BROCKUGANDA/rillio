# Rillio — environment variables (names + safe placeholders only)
#
# Copy to `.env` for local development. NEVER commit real secrets.
# Production injects these through a secret manager; startup fails closed when
# required values are missing or unsafe (see src/lib/env.ts).

# --- Database (PostgreSQL; blueprint §10 modular monolith) ------------------
DATABASE_URL=postgresql://rillio:password@localhost:5432/rillio?schema=public

# --- Solana (read-only portfolio) -------------------------------------------
# Production MUST use a dedicated mainnet-beta RPC with an independent fallback,
# never the shared public endpoint (rate-limited, unreliable, not for apps).
SOLANA_RPC_URL=https://solana-mainnet.example-dedicated-rpc.com
SOLANA_CLUSTER=mainnet-beta

# --- Treasury wallets for onchain subscriptions -----------------------------
# Full base58 Solana addresses. Replace with real, controlled treasury wallets.
USDC_RECIPIENT_WALLET=REPLACE_WITH_BASE58_TREASURY_ADDRESS
SOL_RECIPIENT_WALLET=REPLACE_WITH_BASE58_TREASURY_ADDRESS

# --- SOL quoting ------------------------------------------------------------
# Operator-fixed fallback rate used only when no live oracle is reachable.
# Recorded transparently as pricingMode "operator_fixed" — never an oracle quote.
SOL_PRICE_USD=0

# --- Credential encryption (production required) ----------------------------
# AES-256-GCM key material for provider credentials at rest. Use a secret
# manager value (Vault/Doppler/SSM); at least 16 characters. In production this
# MUST be set — the app refuses to boot without it.
PROVIDER_CREDENTIAL_KEY=replace-with-a-long-random-dev-only-value