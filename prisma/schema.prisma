// Rillio — MVP Prisma schema
// Source: RILLIO_COMPLETE_PRODUCT_AND_ENGINEERING_BLUEPRINT.md §11
// Money is stored as BigInt minor units (amountMinor) with ISO currency codes.
// Raw transaction evidence is kept separate from normalized transaction records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  locale       String   @default("en")
  timezone     String   @default("UTC")
  baseCurrency String   @default("USD")
  status       String   @default("active") // active | suspended | deletion_pending | deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions                Session[]
  imports                 ImportJob[]
  rawTransactions         RawTransaction[]
  transactions            Transaction[]
  categories              Category[]
  categorizationRules     CategorizationRule[]
  cashflowSnapshots       CashflowSnapshot[]
  goals                   Goal[]
  financialConnections    FinancialConnection[]
  providerCredentials    ProviderCredential[]
  subscriptions           Subscription[]
  checkoutSessions        CheckoutSession[]
  invoices                Invoice[]
  paymentIntents          PaymentIntent[]
  paymentSettlements      PaymentSettlement[]
  entitlements            Entitlement[]
  wallets                 Wallet[]
  portfolioSnapshots      PortfolioSnapshot[]
  consents                Consent[]
  notifications           Notification[]
  dataExportRequests      DataExportRequest[]
  deletionRequests        DeletionRequest[]
  auditEvents             AuditEvent[]
}

model Session {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model ImportJob {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  fileName        String
  fileSize        Int
  mimeType        String
  status          String   @default("uploaded") // uploaded | parsing | validating | normalizing | deduplicating | ready | failed | partial
  totalRows       Int      @default(0)
  acceptedRows    Int      @default(0)
  rejectedRows    Int      @default(0)
  duplicateRows   Int      @default(0)
  errorReportJson String?  // JSON-encoded array of {row, field, code, message}
  idempotencyKey  String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  rawTransactions RawTransaction[]

  @@index([userId, createdAt])
}

model RawTransaction {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  importJob          ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  importJobId        String
  sourceRowNumber    Int
  rawPayload         String   // original CSV row JSON-encoded
  sourceHash         String   // sha256 of normalized fingerprint
  externalId         String?
  createdAt          DateTime @default(now())

  transaction        Transaction?

  @@index([userId, importJobId])
  @@index([sourceHash])
}

model Transaction {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  rawTransaction RawTransaction? @relation(fields: [rawTransactionId], references: [id], onDelete: SetNull)
  rawTransactionId String? @unique
  importJobId    String

  // Normalized fields
  occurredAt     DateTime
  accountLabel   String   @default("default")
  merchantName   String?
  description    String
  amountMinor    BigInt   // signed minor units; negative = outflow, positive = inflow
  currency       String   // ISO 4217
  direction      String   // inflow | outflow
  status         String   @default("posted") // posted | pending | refund | transfer
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  sourceProvider String   @default("csv")
  externalTransactionId String?
  fingerprint    String   // (date|amount|description|account) hash for dedupe
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryHistory TransactionCategoryHistory[]

  @@index([userId, occurredAt])
  @@index([userId, categoryId, occurredAt])
  @@index([fingerprint])
}

model TransactionCategoryHistory {
  id            String   @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  categoryId    String?
  actor         String   // user | rule | heuristic | system
  actorRuleId   String?
  reason        String?
  modelVersion  String?
  createdAt     DateTime @default(now())

  @@index([transactionId, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  kind        String   @default("expense") // expense | income | transfer | ignore
  color       String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  transactions      Transaction[]
  categorizationRules CategorizationRule[]
  cashflowSnapshots CashflowSnapshot[]

  @@unique([userId, name])
}

model CategorizationRule {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  field      String   // merchant | description
  pattern    String   // case-insensitive substring or regex
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority   Int      @default(100)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId, enabled, priority])
}

model CashflowSnapshot {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  periodStart    DateTime
  periodEnd      DateTime
  currency       String
  inflowMinor    BigInt   @default(0)
  outflowMinor   BigInt   @default(0)
  netMinor       BigInt   @default(0)
  calculationVersion String @default("v1")
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  createdAt      DateTime @default(now())

  @@unique([userId, periodStart, periodEnd, currency, categoryId])
}

model Goal {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  name            String
  targetMinor     BigInt
  currency        String
  startingAmountMinor BigInt @default(0)
  plannedContributionMinor BigInt @default(0)
  contributionCadence String @default("monthly") // weekly | biweekly | monthly
  targetDate      DateTime?
  status          String   @default("active") // active | paused | archived | completed
  // IMPORTANT: planned allocations are PLANNING records, not held funds (blueprint §4.4 FR-GOAL-003)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events          GoalEvent[]

  @@index([userId, status])
}

model GoalEvent {
  id          String   @id @default(cuid())
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId      String
  type        String   // created | updated | paused | resumed | archived | contribution | scenario
  amountMinor BigInt?
  actor       String   @default("user")
  source      String?
  metadata    String?  // JSON-encoded
  createdAt   DateTime @default(now())

  @@index([goalId, createdAt])
}

model Wallet {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  chain         String   @default("solana")
  address       String
  label         String?
  verification  String   @default("unverified") // unverified | verified
  visibility    String   @default("private")
  lastScanAt    DateTime?
  disconnectedAt DateTime?
  createdAt     DateTime @default(now())

  tokenAccounts     TokenAccount[]
  portfolioSnapshots PortfolioSnapshot[]

  @@unique([userId, address])
  @@index([userId, disconnectedAt])
}

model TokenAccount {
  id              String   @id @default(cuid())
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId        String
  mint            String
  tokenProgram    String   @default("spl-token") // spl-token | token-2022
  symbol          String?
  name            String?
  decimals        Int
  baseUnitAmount  String   // integer string — never float
  snapshotAt      DateTime @default(now())
  verified        Boolean  @default(false)
  unpriced        Boolean  @default(false)
  priceQuoteUsd   String?  // nullable: missing quote state must be visible (FR-CHAIN-003)
  priceSource     String?
  priceObservedAt DateTime?

  @@unique([walletId, mint])
  @@index([walletId])
}

model PortfolioSnapshot {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId        String
  totalUsd        String?  // null when no reliable aggregate price
  quoteCurrency   String   @default("USD")
  pricedAssetCount Int     @default(0)
  unpricedAssetCount Int   @default(0)
  unverifiedAssetCount Int @default(0)
  snapshotAt      DateTime @default(now())
  stale           Boolean  @default(false)

  @@index([userId, snapshotAt])
}

model Consent {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  provider    String
  scope       String
  policyVersion String @default("v1")
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([userId, provider])
}

model Notification {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  type        String
  title       String
  body        String?
  payload     String?  // JSON-encoded
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt, readAt])
}

model DataExportRequest {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  status      String   @default("requested") // requested | processing | ready | failed
  artifactUrl String?
  reason      String?
  requestedAt DateTime @default(now())
  completedAt DateTime?

  @@index([userId, requestedAt])
}

model DeletionRequest {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  status      String   @default("requested") // requested | processing | completed | blocked_legal_hold
  reason      String?
  requestedAt DateTime @default(now())
  completedAt DateTime?

  @@index([userId, requestedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  actor       String
  action      String
  resourceType String
  resourceId  String?
  reason      String?
  requestId   String?
  metadata    String?  // JSON-encoded
  createdAt   DateTime @default(now())

  @@index([resourceType, resourceId, createdAt])
  @@index([userId, createdAt])
}

// ============================================================
// Phase 2 additions — bank providers, billing, payments
// ============================================================

model FinancialConnection {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  provider        String   // e.g. "demo", "plaid", "teller"
  externalId      String?  // provider-side item id
  status          String   @default("active") // active | syncing | error | revoked
  accountsJson    String?  // JSON-encoded list of {id, label, currency}
  lastSyncAt      DateTime?
  lastSyncStatus  String?  // ok | partial | failed
  lastSyncError   String?
  syncCount       Int      @default(0)
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  credential      ProviderCredential?

  @@unique([userId, provider, externalId])
  @@index([userId, status])
}

model ProviderCredential {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  connection      FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId    String   @unique
  // Encrypted credential reference (e.g. access_token ciphertext). Never plaintext.
  ciphertext      String
  iv              String
  algorithm       String   @default("aes-256-gcm")
  rotationDueAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Plan {
  id              String   @id @default(cuid())
  code            String   @unique  // "free" | "plus"
  name            String
  description     String?
  priceMinor      BigInt   @default(0)
  currency        String   @default("USD")
  interval        String   @default("month") // month | year
  featuresJson    String   // JSON-encoded feature list
  isActive        Boolean  @default(true)
  stripePriceId   String?
  usdcRecipient   String?  // for USDC checkout
  createdAt       DateTime @default(now())

  subscriptions   Subscription[]
  checkoutSessions CheckoutSession[]
}

model CheckoutSession {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  plan            Plan     @relation(fields: [planId], references: [id])
  planId          String
  provider        String   // stripe | usdc
  externalId      String?  // Stripe session id or USDC reference
  idempotencyKey  String?
  status          String   @default("open") // open | completed | expired | failed
  amountMinor     BigInt
  currency        String
  returnUrl       String?
  metadata        String?  // JSON-encoded
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  subscription    Subscription?

  @@index([userId, createdAt])
  @@index([externalId])
}

model Subscription {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  plan            Plan     @relation(fields: [planId], references: [id])
  planId          String
  provider        String   // stripe | usdc | free
  externalId      String?  // Stripe subscription id
  status          String   @default("active") // active | trialing | past_due | canceled | paused
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt          DateTime?
  canceledAt        DateTime?
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])
  checkoutSessionId String? @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoices        Invoice[]
  entitlements    Entitlement[]

  @@index([userId, status])
}

model Invoice {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId  String
  providerInvoiceId String?
  amountMinor     BigInt
  currency        String
  state           String   @default("open") // open | paid | void | uncollectible
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model PaymentIntent {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  reference       String   @unique // stable id used in USDC transfer memo / Stripe reference
  payer           String?  // wallet address for USDC
  recipient       String   // wallet address for USDC
  mint            String?  // USDC mint
  amountMinor     BigInt   // exact expected amount in token base units
  currency        String   @default("USD")
  expiry          DateTime
  status          String   @default("pending") // pending | confirmed | failed | expired
  metadata        String?
  createdAt       DateTime @default(now())
  confirmedAt     DateTime?

  settlements     PaymentSettlement[]

  @@index([userId, status])
}

model PaymentSettlement {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  intent          PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  intentId        String
  signature       String   @unique // onchain signature (USDC) or Stripe charge id
  verifiedAmountMinor BigInt
  verifiedMint    String?
  verifiedRecipient String?
  finality        String   // confirmed | finalized | reverted
  reconciledAt    DateTime @default(now())

  @@index([intentId])
}

model Entitlement {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  feature         String   // e.g. "csv_import_limit", "multi_account", "scenario_planning"
  value           String   // e.g. "100000", "true", "false"
  source          String   // subscription | plan_default | promotional
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String?
  effectiveFrom   DateTime @default(now())
  effectiveUntil  DateTime?
  createdAt       DateTime @default(now())

  @@unique([userId, feature])
  @@index([userId, effectiveUntil])
}

model IdempotencyKey {
  id              String   @id @default(cuid())
  key             String   @unique
  scope           String
  requestHash     String
  responseRef     String?
  status          Int      @default(200)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([scope, key])
}
