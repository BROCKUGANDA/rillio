; Project-scoped npm settings.
;
; 1) npm >= 11 rejects a user-global `allow-scripts` entry during project
;    installs (EALLOWSCRIPTS) and a project-level value cannot override it,
;    because the CLI config layer always wins. Unset it per-shell instead:
;       $env:npm_config_allow_scripts = $null
;    This project needs no install scripts, so scripts are also ignored
;    outright (no dependency postinstall execution — defense in depth).
;
; 2) The default cache lives on the C: system drive, which has very little
;    free space here. Point npm at a cache on the project drive.
;
ignore-scripts=true
audit=false
fund=false
cache=D:/AI AZIMARA(AAA)/Rilio/.npm-cache